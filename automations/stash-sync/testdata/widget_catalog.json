[
  {
    "key": "md/banner",
    "scope": "ENVIRONMENT",
    "format": "JSON",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string", "minLength": 1, "maxLength": 280},
        "level": {"enum": ["info", "warning", "error"]}
      }
    }
  },
  {
    "key": "md/links",
    "scope": "ENVIRONMENT",
    "format": "JSON",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["links"],
      "additionalProperties": false,
      "properties": {
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 40},
              "url": {"type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s]+(?![\\s\\S])"}
            }
          }
        }
      }
    }
  },
  {
    "key": "md/health",
    "scope": "INSTANCE",
    "format": "TEXT",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "examples": ["healthy", "degraded", "down"]
    }
  },
  {
    "key": "md/usage",
    "scope": "INSTANCE",
    "format": "JSON",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["value", "max"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0},
        "label": {"type": "string", "maxLength": 64}
      }
    }
  },
  {
    "key": "md/traffic",
    "scope": "INSTANCE",
    "format": "JSON",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["rps", "errors_5m"],
      "additionalProperties": false,
      "properties": {
        "rps": {"type": "number", "minimum": 0},
        "errors_5m": {"type": "integer", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0}
      }
    }
  }
]
