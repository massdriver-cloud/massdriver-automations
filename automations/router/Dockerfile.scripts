# Build from the repository root: docker build -f automations/router/Dockerfile.scripts .
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /massdriver-automations ./cmd/massdriver-automations

FROM alpine:3.22.2@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412
RUN apk add --no-cache ca-certificates curl jq python3 \
    && adduser -D -H -u 65532 -s /sbin/nologin nonroot
COPY --from=build /massdriver-automations /massdriver-automations
USER 65532
EXPOSE 8080
ENTRYPOINT ["/massdriver-automations"]
CMD ["run", "router"]
