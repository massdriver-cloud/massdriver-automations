{
  "md/v1/delivery": {
    "type": "object",
    "required": ["window_days", "deployments", "failed", "rolled_back", "automated"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "window_days": {"type": "integer", "minimum": 1},
      "deployments": {"type": "integer", "minimum": 0},
      "failed": {"type": "integer", "minimum": 0},
      "rolled_back": {"type": "integer", "minimum": 0},
      "failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
      "median_duration_seconds": {"type": "number", "minimum": 0},
      "last_status": {"enum": ["completed", "failed", "aborted", "rejected"]},
      "last_completed_at": {"type": "string", "format": "date-time"},
      "automated": {"type": "integer", "minimum": 0}
    }
  },
  "md/v1/reliability": {
    "type": "object",
    "required": ["window_days", "alarms", "firing", "incidents", "seconds_in_alarm"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "window_days": {"type": "integer", "minimum": 1},
      "alarms": {"type": "integer", "minimum": 0},
      "firing": {"type": "integer", "minimum": 0},
      "incidents": {"type": "integer", "minimum": 0},
      "seconds_in_alarm": {"type": "number", "minimum": 0},
      "median_recovery_seconds": {"type": "number", "minimum": 0},
      "last_fired_at": {"type": "string", "format": "date-time"}
    }
  },
  "md/v1/currency": {
    "type": "object",
    "required": ["version", "latest", "behind"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "version": {"type": "string", "minLength": 1, "maxLength": 128},
      "latest": {"type": "string", "minLength": 1, "maxLength": 128},
      "behind": {"type": "integer", "minimum": 0},
      "latest_published_at": {"type": "string", "format": "date-time"},
      "days_behind": {"type": "integer", "minimum": 0}
    }
  },
  "md/v1/pending": {
    "type": "object",
    "required": ["changed"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "changed": {"type": "boolean"},
      "changed_at": {"type": "string", "format": "date-time"},
      "deployed_at": {"type": "string", "format": "date-time"}
    }
  },
  "md/v1/parity": {
    "type": "object",
    "required": ["reference_environment", "differences", "checked_at"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "reference_environment": {"type": "string", "minLength": 1, "maxLength": 255},
      "differences": {"type": "integer", "minimum": 0},
      "checked_at": {"type": "string", "format": "date-time"},
      "items": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": ["instance", "field", "message"],
          "additionalProperties": false,
          "properties": {
            "instance": {"type": "string", "minLength": 1, "maxLength": 255},
            "field": {"type": "string", "minLength": 1, "maxLength": 255},
            "message": {"type": "string", "minLength": 1, "maxLength": 280}
          }
        }
      }
    }
  },
  "md/v1/ownership": {
    "type": "object",
    "required": ["groups", "members"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "groups": {"type": "array", "maxItems": 50, "items": {"type": "object", "required": ["id", "name"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 255}, "name": {"type": "string", "minLength": 1, "maxLength": 255}}}},
      "members": {"type": "integer", "minimum": 0}
    }
  },
  "instance.scorecard": {
    "type": "object",
    "required": ["level", "score", "passed", "failed", "unknown", "checks", "evaluated_at"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "level": {"type": "string", "minLength": 1, "maxLength": 32},
      "score": {"type": "number", "minimum": 0, "maximum": 100},
      "passed": {"type": "integer", "minimum": 0},
      "failed": {"type": "integer", "minimum": 0},
      "unknown": {"type": "integer", "minimum": 0},
      "checks": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": ["id", "status"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 64},
            "status": {"enum": ["passed", "failed", "unknown"]},
            "message": {"type": "string", "minLength": 1, "maxLength": 280}
          }
        }
      },
      "evaluated_at": {"type": "string", "format": "date-time"}
    }
  },
  "scorecard-rollup": {
    "type": "object",
    "required": ["level", "instances", "levels", "lowest_level", "evaluated_at"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "minLength": 1, "maxLength": 64},
      "level": {"type": "string", "minLength": 1, "maxLength": 32},
      "score": {"type": "number", "minimum": 0, "maximum": 100},
      "instances": {"type": "integer", "minimum": 0},
      "levels": {
        "type": "object",
        "maxProperties": 10,
        "propertyNames": {"type": "string", "minLength": 1, "maxLength": 32},
        "additionalProperties": {"type": "integer", "minimum": 0}
      },
      "lowest_level": {"type": "string", "minLength": 1, "maxLength": 32},
      "evaluated_at": {"type": "string", "format": "date-time"}
    }
  }
}
